# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Materiały ZUS (nie rozpowszechniać) i korpus asystenta
/private-cases/
/data/corpus/*.txt
.shot.tmp.mjs
.flow.tmp.mjs
/data/param-sets.json
/data/audit-log.json
/data/features.json
/test-results/
/playwright-report/
/.next-dev/

# Prezentacja i film: pliki robocze (warianty slajdów, brief z materiałami zewnętrznymi, wygenerowane audio/wideo — film jest na YouTube)
/prezentacja/work/
/prezentacja/brief/
/prezentacja/film/audio/
/prezentacja/film/*.mp4
/prezentacja/slides/*.pdf
