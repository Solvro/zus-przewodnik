# Funkcje AI (odczyt dokumentów, asystent, prosty język). Wystarczy JEDEN klucz:
# Claude ma pierwszeństwo, jeśli ustawiono oba. Bez kluczy — tryb awaryjny (asystent z bazy wiedzy, sprawy przykładowe bez AI).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Opcjonalnie: modele OpenAI (domyślnie gpt-5.5 do odczytu dokumentów, gpt-5.4-mini do asystenta)
# OPENAI_MODEL=gpt-5.5
# OPENAI_MODEL_FAST=gpt-5.4-mini

# Token panelu administracyjnego (/admin). Domyślnie w demo: demo-admin
ADMIN_TOKEN=demo-admin
